# The runtime is the esbuild bundle in dist/ — everything that produced it stays out.
src/**
out/**
node_modules/**
tsconfig.json
.vscode/**
**/*.map
**/*.ts
.gitignore
.vscodeignore

# A packaged .vsix in the extension root would otherwise be packed into the next one.
*.vsix

# The bundled Claude Code mod ships as source: Claude Code loads its .ts and .tsx.
!claude-mod/**
