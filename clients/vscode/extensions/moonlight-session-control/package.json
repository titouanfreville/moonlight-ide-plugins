{
  "name": "moonlight-session-control",
  "displayName": "MoonlightCode Session Control",
  "description": "Adopt Claude Code sessions into governance, set their workflow phase, and start governed sessions.",
  "version": "0.1.7",
  "private": false,
  "publisher": "titouanfreville",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/titouanfreville/moonlight-ide-plugins"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "icon": "icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "moonlight-control-client": "*",
    "moonlight-core": "*"
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./ && node ../../scripts/esbuild.js --dev",
    "watch": "node ../../scripts/esbuild.js --dev --watch",
    "bundle": "node ../../scripts/esbuild.js",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "test": "node --test out"
  },
  "extensionDependencies": [
    "titouanfreville.moonlight-core"
  ],
  "contributes": {
    "commands": [
      {
        "command": "moonlight.sessionControl.setActive",
        "title": "MoonlightCode: Set Active Session"
      },
      {
        "command": "moonlight.sessionControl.adopt",
        "title": "MoonlightCode: Adopt a Claude Code Session"
      },
      {
        "command": "moonlight.sessionControl.setPhase",
        "title": "MoonlightCode: Set Session Phase"
      },
      {
        "command": "moonlight.sessionControl.startSession",
        "title": "MoonlightCode: Start Session in Owned Terminal",
        "icon": "$(add)"
      },
      {
        "command": "moonlight.sessions.refresh",
        "title": "MoonlightCode: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "moonlight.sessions.adopt",
        "title": "MoonlightCode: Adopt This Session",
        "icon": "$(shield)"
      },
      {
        "command": "moonlight.sessions.setPhase",
        "title": "MoonlightCode: Set Phase",
        "icon": "$(list-selection)"
      },
      {
        "command": "moonlight.sessions.advancePhase",
        "title": "MoonlightCode: Advance Phase",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "moonlight.sessions.setActive",
        "title": "MoonlightCode: Follow This Session",
        "icon": "$(eye)"
      },
      {
        "command": "moonlight.sessions.reviewPlan",
        "title": "MoonlightCode: Review the Held Plan",
        "icon": "$(bell-dot)"
      },
      {
        "command": "moonlight.sessions.answerHold",
        "title": "MoonlightCode: Answer the Held Action",
        "icon": "$(bell-dot)"
      },
      {
        "command": "moonlight.sessions.createGroup",
        "title": "New Session Group",
        "category": "MoonlightCode",
        "icon": "$(new-folder)"
      },
      {
        "command": "moonlight.sessions.addToGroup",
        "title": "Add to Group…",
        "category": "MoonlightCode",
        "icon": "$(folder)"
      },
      {
        "command": "moonlight.sessions.removeFromGroup",
        "title": "Remove from Group",
        "category": "MoonlightCode"
      },
      {
        "command": "moonlight.sessions.renameGroup",
        "title": "Rename Group",
        "category": "MoonlightCode",
        "icon": "$(edit)"
      },
      {
        "command": "moonlight.sessions.deleteGroup",
        "title": "Delete Group",
        "category": "MoonlightCode",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moonlight",
          "title": "MoonlightCode",
          "icon": "resources/moonlight.svg"
        }
      ]
    },
    "views": {
      "moonlight": [
        {
          "type": "webview",
          "id": "moonlight.panel",
          "name": "MoonlightCode"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "moonlight.sessionControl.startSession",
          "when": "view == moonlight.panel",
          "group": "navigation@1"
        },
        {
          "command": "moonlight.sessions.createGroup",
          "when": "view == moonlight.panel",
          "group": "navigation@2"
        },
        {
          "command": "moonlight.sessions.refresh",
          "when": "view == moonlight.panel",
          "group": "navigation@3"
        }
      ]
    }
  },
  "keywords": [
    "claude",
    "claude code",
    "ai",
    "agent",
    "agentic",
    "coding agent",
    "moonlight",
    "session",
    "adopt",
    "workflow",
    "phase"
  ]
}
